    "react-schema-render": "^0.0.5",
    "react-screenshots": "^0.5.22",
    "react-syntax-highlighter": "^15.6.1",
    "tesseract.js": "^6.0.1",
    "umi": "^4.4.11",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.33",
    "@types/react-dom": "^18.0.11",
    "monaco-editor-webpack-plugin": "^7.1.0",
    "typescript": "^5.0.3",
    "worker-loader": "^3.0.8"
  },
  "build": {
    "appId": "xxxxxxx",
    "productName": "xxxxxx",
    "copyright": "Copyright © 2024 ${author}",
    "win": {
      "icon": "./src/assets/flower.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}_setup_${version}.${ext}",
      "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "installerIcon": "./src/assets/flower.png",
        "uninstallerIcon": "./src/assets/flower.png",
        "installerHeaderIcon": "./src/assets/flower.png",
        "createDesktopShortcut": true,
        "createStartMenuShortcut": false
      }
    }
  }
}
