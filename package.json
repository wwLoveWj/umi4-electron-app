    "child_process": "^1.0.2",
    "cronstrue": "^2.61.0",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.13",
    "docx": "^9.5.0",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "electron": "^29.4.6",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.6.2",
    "electron-winstaller": "^5.4.0",
    "extract-zip": "^2.0.1",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "lodash-es": "^4.17.21",
    "mammoth": "^1.9.1",
