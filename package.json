{
  "name": "umi-electron-wj",
  "version": "1.0.0",
  "description": "",
  "main": "./electron/main.js",
  "private": true,
  "author": "wwLoveWj",
  "scripts": {
    "dev": "umi dev",
    "build": "umi build",
    "postinstall": "umi setup",
    "setup": "umi setup",
    "start": "npm run dev",
    "electron": "cross-env NODE_ENV=development electron .",
    "yyds": "electron-packager . electron-quick-start --win --out ../electron-quick-start --arch=x64 --app-version=1.0.0 --electron-version=29.4.6 --overwrite --ignore=node_modules"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
